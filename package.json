{
  "name": "ra2commander",
  "version": "0.1.3",
  "private": true,
  "description": "基于 ra2web 公共玩家 API 的本机语音指挥伴随程序",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "companion": "tsx apps/companion/src/main.ts",
    "desktop": "pnpm --filter @ra2c/desktop start",
    "desktop:check": "pnpm --filter @ra2c/desktop test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "ui:check": "node --import tsx --test apps/companion/test/workbench.test.ts",
    "maps:check": "node --import tsx packages/maps/src/check.ts",
    "prompts:check": "node --import tsx packages/command/src/check-prompts.ts",
    "capabilities:generate": "node --import tsx packages/command/src/generate-capabilities.ts",
    "capabilities:check": "node --import tsx apps/companion/src/capabilities/check.ts",
    "records:read": "node --import tsx apps/companion/tools/read-battle.ts",
    "records:export": "node --import tsx apps/companion/tools/export-battle.ts",
    "scenario:voice": "node --import tsx apps/companion/tools/run-voice-scenario.mjs",
    "playwright-install": "pnpm --filter @ra2c/companion exec playwright install chromium",
    "game-data:import": "node --import tsx packages/command/src/import-game-data.ts",
    "game-data:check": "node --import tsx packages/command/src/check-game-data.ts",
    "speech:install": "node --import tsx apps/companion/tools/install-speech-model.ts",
    "speech:check": "node --import tsx apps/companion/tools/check-speech-model.ts",
    "game:resources:install": "node --import tsx apps/companion/tools/install-game-resources.ts",
    "game:resources:check": "node --import tsx apps/companion/tools/check-game-resources.ts",
    "game:site:install": "node --import tsx apps/companion/tools/install-game-site.ts",
    "build": "node --import tsx apps/desktop/tools/build.ts",
    "dist:linux": "node apps/desktop/tools/linux-build.mjs",
    "dist:mac": "node apps/desktop/tools/native-build.mjs mac",
    "dist:win": "node apps/desktop/tools/native-build.mjs win",
    "dist:check": "node apps/desktop/tools/verify-linux.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron-builder": "26.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.4.0"
}
