# 命令编译云端模型密钥（复制为 .env 填写；.env 已 gitignore，不要提交）
# 任意 OpenAI 兼容服务都能接入：加一组 MODEL_<名称>_* 即可，随后 `model <名称>` 切换。

# DeepSeek 开放平台 https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM 开放平台 https://open.bigmodel.cn/
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash

# 泛化接入示例（任意 OpenAI 兼容服务；去掉注释填入即可）
# MODEL_QWEN_API_KEY=
# MODEL_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_QWEN_MODEL=qwen3-coder-flash
